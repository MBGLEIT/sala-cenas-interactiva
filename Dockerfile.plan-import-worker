FROM node:20-bookworm-slim

ENV NODE_ENV=production
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip python3-venv build-essential \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY scripts/requirements-plan-import-worker.txt ./scripts/requirements-plan-import-worker.txt
RUN pip3 install --break-system-packages -r ./scripts/requirements-plan-import-worker.txt

COPY . .

HEALTHCHECK --interval=60s --timeout=15s --start-period=20s --retries=3 \
  CMD npm run worker:plan-import:check || exit 1

CMD ["npm", "run", "worker:plan-import"]
